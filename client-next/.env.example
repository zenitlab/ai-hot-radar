
# SEO Configuration
NEXT_PUBLIC_SITE_URL=https://aihotradar.com

# Backend origin used by CLIENT code via the rewrites in next.config.ts.
# In docker-compose this is the service name, not localhost.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Backend origin used by SERVER-side rendering (lib/server-api.ts).
# Server components have no origin, so they need an absolute URL. Falls back to
# NEXT_PUBLIC_API_URL, then http://localhost:3001, when unset.
# In Docker this must be the backend service name — the frontend container's
# own localhost has nothing listening on 3001, which would silently render
# every server-side page empty. Production uses http://backend:3001.
INTERNAL_API_URL=http://localhost:3001
